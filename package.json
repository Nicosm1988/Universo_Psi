{
  "name": "universo-psi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db:search": "docker exec -i supabase_db_Universo_Psi psql -v ON_ERROR_STOP=1 -U postgres -d postgres < supabase/tests/database/professional_search.sql",
    "test:db:workflow": "docker exec -i supabase_db_Universo_Psi psql -v ON_ERROR_STOP=1 -U postgres -d postgres < supabase/tests/database/professional_submission_workflow.sql",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types typescript --local > src/types/database.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "resend": "6.20.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "supabase": "2.114.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
