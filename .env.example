# Public application configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Bloquea indexación en entornos públicos de prueba; Preview también la bloquea.
SITE_NOINDEX=false

# Server-only Supabase key. Never expose it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only random salt used to hash abuse-prevention identifiers.
RATE_LIMIT_SALT=

# Optional transactional email (lead delivery stays queued when absent).
RESEND_API_KEY=
EMAIL_FROM=

# Authenticates Vercel Cron calls to the private outbox worker (32+ random chars).
CRON_SECRET=

# Optional Mercado Pago adapter. Credentials are namespaced per account so
# a future move from the founder's personal MP account to the incorporated
# company's account is a config change (flip MERCADOPAGO_ACTIVE_ACCOUNT),
# never a code change or a rewrite of already-created subscriptions.
# El modo se verifica con la identidad de la cuenta y los pagos del proveedor;
# el prefijo del token no demuestra que una operación sea de prueba.
# Configurar una cuenta vendedora de prueba para sandbox. Producción requiere
# aprobar previamente el recorrido probado y la configuración concreta.
# Open only after the environment has been verified and activation approved.
# false keeps webhooks/manual reconciliation available using existing credentials.
MERCADOPAGO_CHECKOUT_ENABLED=false
MERCADOPAGO_ACTIVE_ACCOUNT=personal
MERCADOPAGO_PERSONAL_ACCESS_TOKEN=
MERCADOPAGO_PERSONAL_PUBLIC_KEY=
MERCADOPAGO_PERSONAL_WEBHOOK_SECRET=
MERCADOPAGO_PERSONAL_ENVIRONMENT=
MERCADOPAGO_PERSONAL_COLLECTOR_ID=
MERCADOPAGO_COMPANY_ACCESS_TOKEN=
MERCADOPAGO_COMPANY_PUBLIC_KEY=
MERCADOPAGO_COMPANY_WEBHOOK_SECRET=
MERCADOPAGO_COMPANY_ENVIRONMENT=
MERCADOPAGO_COMPANY_COLLECTOR_ID=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Optional observability providers.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=

# Test-only: prevents external writes during browser tests.
UNIVERSO_PSI_TEST_MODE=

# PayPal: USD fijo, credenciales separadas. Live queda apagado.
PAYPAL_ENV=sandbox
PAYPAL_LIVE_CHECKOUT_ENABLED=false
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=
PAYPAL_SANDBOX_PLANS=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_WEBHOOK_ID=
PAYPAL_LIVE_PLANS=
# Opcional: ID público del entorno elegido; sin SDK en el checkout alojado.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
